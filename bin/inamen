#!/usr/bin/env ruby

begin
  require "bundler/setup"
rescue LoadError
  nil
end

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "inamen"
require "inamen/counting_service"

def parse_scan_scope(raw)
  case raw.to_s.downcase.tr("-", "_")
  when "whole", "whole_bible" then :whole_bible
  when "ot" then :ot
  when "nt" then :nt
  else raw.to_s
  end
end

def kjv_lines
  @kjv_lines ||= Inamen::KjvEditions.read_lines(kjv_input_path)
end

def kjv_input_path
  @kjv_input_path ||= File.expand_path("../data/KJV.txt", __dir__)
end

PSALM_HEADER = /\APSALM [0-9]+\z/

if ARGV[0] == "kjvcode-align"
  require "inamen/kjvcode_alignment"
  Inamen::KjvcodeAlignment.report(kjv_lines)
  exit 0
end

if ARGV[0] == "index"
  require "inamen/corpus_indexer"
  require "inamen/corpus_store"

  output = File.expand_path("../data/kjv_corpus.sqlite", __dir__)
  force = false
  args = ARGV[1..] || []
  i = 0
  while i < args.length
    case args[i]
    when "--output", "-o"
      i += 1
      output = File.expand_path(args[i])
    when "--input", "-i"
      i += 1
      @kjv_input_path = File.expand_path(args[i])
      @kjv_lines = nil
    when "--edition", "-e"
      i += 1
      edition = args[i].to_s
      path = Inamen::KjvEditions::EDITIONS[edition]
      unless path
        warn "Unknown edition: #{edition} (choose: #{Inamen::KjvEditions::EDITIONS.keys.join(", ")})"
        exit 1
      end
      @kjv_input_path = path
      @kjv_lines = nil
    when "--force", "-f"
      force = true
    else
      warn "Unknown option: #{args[i]}"
      warn "Usage: #{$PROGRAM_NAME} index [--input PATH | --edition ID] [--output PATH] [--force]"
      exit 1
    end
    i += 1
  end

  if File.exist?(output) && !force
    warn "Corpus already exists at #{output} (use --force to rebuild)"
    exit 1
  end

  path = Inamen::CorpusStore.build!(kjv_lines, path: output)
  db = Inamen::CorpusStore.open(path)
  counts = Inamen::CorpusStore.bucket_counts(db)
  db.close
  puts "Source: #{kjv_input_path}"
  puts "Corpus: #{path}"
  counts.each { |bucket, n| puts "#{bucket}: #{n}" }
  puts "scannable total: #{counts.values.sum}"
  exit 0
end

if ARGV[0] == "corpora" && ARGV[1] == "prebuild"
  require "inamen/corpus_publisher"
  require "inamen/verse_index_publisher"
  require "inamen/word_stream_publisher"
  require "inamen/lexicon_publisher"
  require "inamen/canon_ordinals_publisher"

  force = ARGV.include?("--force") || ARGV.include?("-f")
  Inamen::CorpusPublisher.build_all_prebuilt!(force: force).each do |built_path|
    puts built_path
  end
  Inamen::VerseIndexPublisher.build_all_prebuilt!(force: force).each do |built_path|
    puts built_path
  end
  Inamen::WordStreamPublisher.build_all_prebuilt!(force: force).each do |built_path|
    puts built_path
  end
  Inamen::LexiconPublisher.build_all_prebuilt!(force: force).each do |built_path|
    puts built_path
  end
  Inamen::CanonOrdinalsPublisher.build_all_prebuilt!(force: force).each do |built_path|
    puts built_path
  end
  exit 0
end

if ARGV[0] == "scan"
  require "inamen/corpus_store"
  require "inamen/divisible_by_seven_scan"

  divisible_by = 7
  scope = :whole_bible
  min_count = 1
  bucket = :default
  corpus_path = File.expand_path("../data/kjv_corpus.sqlite", __dir__)
  args = ARGV[1..] || []
  i = 0
  while i < args.length
    case args[i]
    when "--divisible-by", "-d"
      i += 1
      divisible_by = Integer(args[i])
    when "--scope", "-s"
      i += 1
      scope = parse_scan_scope(args[i])
    when "--bucket", "-b"
      i += 1
      bucket = args[i]
    when "--min-count", "-m"
      i += 1
      min_count = Integer(args[i])
    when "--corpus", "-c"
      i += 1
      corpus_path = File.expand_path(args[i])
    else
      warn "Unknown option: #{args[i]}"
      warn "Usage: #{$PROGRAM_NAME} scan [--divisible-by N] [--scope whole|ot|nt|Book] [--bucket verse_text|psalm_heading|colophon|default] [--min-count N] [--corpus PATH]"
      exit 1
    end
    i += 1
  end

  begin
    db = Inamen::CorpusStore.open(corpus_path)
    Inamen::DivisibleBySevenScan.print_scan(
      db,
      divisible_by: divisible_by,
      scope: scope,
      bucket: bucket,
      min_count: min_count
    )
    db.close
  rescue ArgumentError, SQLite3::Exception => e
    warn e.message
    exit 1
  end
  exit 0
end

if ARGV[0] == "feature" || ARGV[0] == "features"
  require "inamen/features"

  corpus_path = File.expand_path("../data/kjv_corpus.sqlite", __dir__)
  use_corpus = false
  args = (ARGV[0] == "features" ? ARGV[1..] : ARGV[1..]) || []
  args = args.dup
  i = 0
  while i < args.length
    case args[i]
    when "--corpus", "-c"
      i += 1
      corpus_path = File.expand_path(args[i])
      use_corpus = true
    when "--use-corpus"
      use_corpus = true
    else
      break
    end
    i += 1
  end
  args = args[i..] || []

  db = nil
  if use_corpus || File.file?(corpus_path)
    begin
      require "inamen/corpus_store"
      db = Inamen::CorpusStore.open(corpus_path)
    rescue ArgumentError
      db = nil
    end
  end

  if ARGV[0] == "features" || args.empty? || args.include?("--list")
    Inamen::Features.print_catalog
    db&.close
    exit 0
  end

  if args.first == "--all"
    Inamen::Features.run_all(lines: kjv_lines, db: db, path: kjv_input_path).each do |result|
      Inamen::Features.print_result(result)
      puts
    end
  else
    id = args.first
    begin
      result = Inamen::Features.run(id, lines: kjv_lines, db: db, path: kjv_input_path)
      Inamen::Features.print_result(result)
    rescue ArgumentError => e
      warn e.message
      db&.close
      exit 1
    end
  end

  db&.close
  exit 0
end

if ARGV[0] == "chapter"
  if ARGV.length < 3
    warn "Usage: #{$PROGRAM_NAME} chapter <Book Name> <Chapter Number>"
    exit 1
  end

  ch_arg = ARGV[-1]
  unless ch_arg.match?(/\A\d+\z/)
    warn "Chapter number must be a positive integer."
    exit 1
  end

  book_name = ARGV[1..-2].join(" ")
  begin
    Inamen::ChapterReport.print_chapter(kjv_lines, book: book_name, chapter: ch_arg.to_i)
  rescue ArgumentError => e
    warn e.message
    exit 1
  end
  exit 0
end

if ARGV[0] == "chapters-divisible-by-7"
  Inamen::ChapterReport.print_chapters_divisible_by_7(kjv_lines)
  exit 0
end

if ARGV[0] == "line-samples"
  limit = (n = ARGV[1].to_i).positive? ? n : 3
  Inamen::LineClassifier.print_sample_report(kjv_lines, limit: limit)
  exit 0
end

if ARGV[0] == "text-words-debug"
  Inamen::TextWordsDebugReport.print_report(kjv_lines)
  exit 0
end

if ARGV[0] == "psalm-heading-words-debug"
  Inamen::PsalmHeadingWordsDebugReport.print_report(kjv_lines)
  exit 0
end

if ARGV[0] == "psalms-unclassified-debug"
  Inamen::LineClassifier.print_psalms_unclassified_report(kjv_lines)
  exit 0
end

if ARGV[0] == "book-stats-debug"
  all = ARGV.include?("--all")
  Inamen::BookStatsReport.print_comparison(kjv_lines, all: all)
  exit 0
end

if ARGV[0] == "numeric-chapters-debug"
  entries = Inamen::CountingService.numeric_chapter_debug_entries(kjv_lines)
  entries.each do |e|
    puts "---"
    puts "line #{e[:lineno]}: #{e[:raw]}"
    puts "  previous non-empty: #{e[:prev_raw] || '(none)'}"
    puts "  next non-empty: #{e[:next_raw] || '(none)'}"
  end
  puts "---"
  puts "Total numeric chapter lines: #{entries.size}"
  exit 0
end

if ARGV[0] == "psalm-debug"
  kjv_lines.each_with_index do |line, i|
    next unless line.to_s.strip.match?(PSALM_HEADER)

    lineno = i + 1
    puts "line #{lineno}: #{line}"
    puts "  classification: #{Inamen::LineClassifier.classify(line)}"

    shown = 0
    j = i + 1
    while j < kjv_lines.length && shown < 2
      nxt = kjv_lines[j]
      j += 1
      next if nxt.to_s.strip.empty?

      shown += 1
      puts "  next non-empty (line #{j}): #{nxt}"
      puts "    classification: #{Inamen::LineClassifier.classify(nxt)}"
    end
    puts
  end
  exit 0
end

Inamen::SummaryReport.print_summary(kjv_lines)
