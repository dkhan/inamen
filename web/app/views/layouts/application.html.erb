<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Inamen" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Inamen">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "turbo", defer: true %>
  </head>

  <body>
    <header class="site-header">
      <div class="site-header-row">
        <a href="/" class="site-logo">Inamen</a>
        <nav class="site-nav">
          <%= link_to "Features", features_path(edition: current_edition_id), data: { turbo_preload: true } %>
          <%= link_to "Discover", discover_path_with_state, data: { turbo_preload: true } %>
          <%= link_to "Scripture", scripture_path_with_state, data: { turbo_preload: true } %>
        </nav>
      </div>
      <p class="site-tagline">Discover mathematical patterns in text</p>
    </header>
    <main class="<%= content_for?(:main_class) ? yield(:main_class) : "site-main" %>">
      <%= yield %>
    </main>
  </body>
</html>
