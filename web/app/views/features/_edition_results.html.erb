<% results = local_assigns.fetch(:results) %>
<% saved_feature = local_assigns.fetch(:saved_feature) %>
<section class="panel">
  <h2>Verification by edition</h2>
  <table class="features-table">
    <thead>
      <tr>
        <th>Edition</th>
        <th class="num">Actual</th>
        <th class="num">Expected</th>
        <th>Status</th>
        <th>Verified</th>
      </tr>
    </thead>
    <tbody>
      <% results.each do |record| %>
        <tr>
          <td><code><%= record.edition_id %></code></td>
          <td class="num"><%= record.actual.nil? ? "—" : number_research_link(record.actual) %></td>
          <td class="num"><%= number_research_link(saved_feature.expected_count) %></td>
          <td>
            <%= feature_discover_status_link(
                  saved_feature.url_id,
                  match: record.status_match?,
                  edition: record.edition_id
                ) %>
          </td>
          <td><%= record.verified_at ? record.verified_at.strftime("%Y-%m-%d %H:%M") : "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
