<% content_for :title, "#{@saved_feature.name} — Inamen" %>

<div class="page-header">
  <h1><%= @saved_feature.name %></h1>
  <p class="lead"><%= @row.description %></p>
  <% if @row.kjvcode_url.present? %>
    <p class="lead-meta"><%= feature_kjvcode_link(@row.kjvcode_url) %></p>
  <% end %>
  <div class="feature-show-actions">
    <%= saved_feature_actions(@row, edition: @edition.edition_id) %>
  </div>
</div>

<section class="panel">
  <dl class="stats">
    <div>
      <dt>Actual</dt>
      <dd><%= format_feature_count(@row.count) %> <%= @row.unit %></dd>
    </div>
    <div>
      <dt>Expected</dt>
      <dd><%= format_feature_count(@row.expected) %> <%= @row.unit %></dd>
    </div>
    <div>
      <dt>Status</dt>
      <dd><%= feature_discover_status_link(@row.id, match: @row.match, edition: @edition.edition_id) %></dd>
    </div>
    <div>
      <dt>Feature type</dt>
      <dd><%= feature_type_label(@saved_feature.feature_type) %></dd>
    </div>
    <div>
      <dt>Scope</dt>
      <dd><%= @row.scope %></dd>
    </div>
    <div>
      <dt>Edition</dt>
      <dd><code><%= @edition.edition_id %></code></dd>
    </div>
  </dl>
</section>

  <% if @edition_results.present? %>
    <%= render "edition_results", results: @edition_results, saved_feature: @saved_feature %>
  <% end %>

  <% if @row.kjvcode_expected %>
    <section class="panel">
      <h2>KJV Code alignment</h2>
      <p>
        Target: <strong><%= format_feature_count(@row.kjvcode_expected) %></strong>
        — <%= feature_match_badge(@row.kjvcode_match) %>
      </p>
    </section>
  <% end %>

  <% if @row.notes.present? %>
    <section class="panel">
      <h2>Notes</h2>
      <div class="feature-notes"><%= format_feature_notes(@row.notes) %></div>
    </section>
  <% end %>

  <% if @row.details.present? %>
    <section class="panel">
      <h2>Details</h2>
      <ul class="detail-list">
        <% @row.details.each do |line| %>
          <li><code><%= line %></code></li>
        <% end %>
      </ul>
    </section>
  <% end %>
<p class="back-link">
  <%= link_to "← All features", features_path(edition: @edition.edition_id) %>
</p>
