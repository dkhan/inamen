<% content_for :title, "#{(@row || @entry || @saved_feature).name} — Inamen" %>
<% if @status == :computing %>
  <% content_for :head do %>
    <meta http-equiv="refresh" content="3">
  <% end %>
<% end %>

<div class="page-header">
  <% unless @saved_feature %>
    <p class="breadcrumb">
      <%= link_to "Features", features_path(edition: @edition.edition_id) %>
      / <code><%= @row&.id || @entry&.id %></code>
    </p>
  <% end %>
  <h1><%= @saved_feature&.name || @row&.name || @entry&.name %></h1>
  <% if @saved_feature %>
    <p class="lead"><%= @row.description %></p>
    <% if @row.kjvcode_url.present? %>
      <p class="lead-meta"><%= feature_kjvcode_link(@row.kjvcode_url) %></p>
    <% end %>
    <div class="feature-show-actions">
      <%= saved_feature_actions(@row, edition: @edition.edition_id) %>
    </div>
  <% else %>
    <p class="lead"><%= (@row || @entry).description %></p>
    <% kjvcode_url = (@row&.kjvcode_url || @entry.kjvcode_url) %>
    <% if kjvcode_url.present? %>
      <p class="lead-meta"><%= feature_kjvcode_link(kjvcode_url) %></p>
    <% end %>
  <% end %>
</div>

<% if @status == :computing %>
  <section class="panel notice">
    <p><strong>Verifying…</strong> Results for this edition are still being computed. This page will refresh automatically.</p>
  </section>
<% elsif @status == :pending %>
  <section class="panel notice">
    <p>
      <strong>No results yet.</strong>
      <%= link_to "Run verification", features_path(edition: @edition.edition_id) %>
      on the catalog page to compute counts for this edition.
    </p>
  </section>
<% end %>

<% if @row %>
  <section class="panel">
    <dl class="stats">
      <div>
        <dt>Actual</dt>
        <dd><%= format_feature_count(@row.count) %> <%= @row.unit %></dd>
      </div>
      <div>
        <dt>Expected</dt>
        <dd><%= format_feature_count(@row.expected) %></dd>
      </div>
      <div>
        <dt>Status</dt>
        <dd><%= feature_discover_status_link(@row.id, match: @row.match, edition: @edition.edition_id) %></dd>
      </div>
      <div>
        <dt>Scope</dt>
        <dd><%= @saved_feature ? @row.scope : @row.scope.tr("_", " ") %></dd>
      </div>
      <div>
        <dt>Edition</dt>
        <dd><code><%= @edition.edition_id %></code></dd>
      </div>
    </dl>
  </section>

  <% if @row.kjvcode_expected %>
    <section class="panel">
      <h2>KJV Code alignment</h2>
      <p>
        Target: <strong><%= format_feature_count(@row.kjvcode_expected) %></strong>
        — <%= feature_match_badge(@row.kjvcode_match) %>
      </p>
    </section>
  <% end %>

  <% if @row.notes.present? %>
    <section class="panel">
      <h2>Notes</h2>
      <div class="feature-notes"><%= format_feature_notes(@row.notes) %></div>
    </section>
  <% end %>

  <% if @row.details.present? %>
    <section class="panel">
      <h2>Details</h2>
      <ul class="detail-list">
        <% @row.details.each do |line| %>
          <li><code><%= line %></code></li>
        <% end %>
      </ul>
    </section>
  <% end %>
<% elsif @entry %>
  <section class="panel">
    <dl class="stats">
      <div>
        <dt>Expected</dt>
        <dd><%= format_feature_count(@edition.expected_count(@entry.id)) %> <%= @entry.unit %></dd>
      </div>
      <div>
        <dt>Scope</dt>
        <dd><%= @entry.scope.tr("_", " ") %></dd>
      </div>
      <div>
        <dt>Edition</dt>
        <dd><code><%= @edition.edition_id %></code></dd>
      </div>
    </dl>
  </section>
<% end %>

<p class="back-link">
  <%= link_to "← All features", features_path(edition: @edition.edition_id) %>
</p>
