<div class="notes-editor" data-notes-editor>
  <div class="notes-editor-toolbar" data-notes-editor-toolbar role="toolbar" aria-label="Notes formatting">
    <button type="button" class="notes-editor-button" data-format="bold" title="Bold" aria-label="Bold">
      <strong>B</strong>
    </button>
    <button type="button" class="notes-editor-button" data-format="italic" title="Italic" aria-label="Italic">
      <em>I</em>
    </button>
    <button type="button" class="notes-editor-button" data-format="strike" title="Strikethrough" aria-label="Strikethrough">
      <s>S</s>
    </button>
    <button type="button" class="notes-editor-button" data-format="bullet" title="Bullet list" aria-label="Bullet list">
      •
    </button>
  </div>
  <%= form.text_area :notes, rows: 6, class: "form-input form-textarea",
      placeholder: "Optional notes about this feature",
      data: { notes_editor_target: true } %>
  <p class="hint">
    Blank lines start a new paragraph. Use the toolbar or
    <code>**bold**</code>, <code>*italic*</code>, <code>~~strikethrough~~</code>, and <code>- item</code> for bullets.
  </p>
</div>
