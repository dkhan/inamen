<% content_for :title, "Features — Inamen" %>
<% if @status == :computing %>
  <% content_for :head do %>
    <meta http-equiv="refresh" content="3">
  <% end %>
<% end %>

<% if flash[:notice].present? %>
  <section class="panel notice">
    <p><%= flash[:notice] %></p>
  </section>
<% end %>

<% if flash[:alert].present? %>
  <section class="panel notice">
    <p><%= flash[:alert] %></p>
  </section>
<% end %>

<section class="panel toolbar">
  <%= form_with url: features_path, method: :get, local: true, class: "toolbar-form" do %>
    <label>
      Edition
      <%= select_tag :edition, edition_options(@edition.edition_id), onchange: "this.form.requestSubmit()" %>
    </label>
  <% end %>

  <%= form_with url: verify_features_path, method: :post, local: true, class: "toolbar-form toolbar-actions" do %>
    <%= hidden_field_tag :edition, @edition.edition_id %>
    <% unless @status == :ready %>
      <%= button_tag "Run verification", type: "submit", class: "button button-primary" %>
    <% end %>
    <%= button_tag "Recompute", name: "refresh", value: "1", type: "submit", class: "button button-secondary" %>
  <% end %>

  <p class="hint">
    Switch edition to view cached results. Recompute runs in the background when the corpus index still needs building; otherwise results return immediately.
  </p>
</section>

<% if @status == :computing %>
  <section class="panel notice">
    <p><strong>Verifying…</strong> Building the corpus index and running all <%= @catalog.size %> features. This page refreshes every few seconds.</p>
  </section>
<% elsif @status == :pending %>
  <section class="panel notice">
    <p><strong>No results yet.</strong> Click <em>Run verification</em> to compute counts for this edition.</p>
  </section>
<% end %>

<section class="panel">
  <table class="features-table">
    <thead>
      <tr>
        <th>Status</th>
        <th>Feature</th>
        <th class="num">Actual</th>
        <th class="num">Expected</th>
        <th>Unit</th>
        <th>Scope</th>
        <th class="feature-actions-head" aria-label="Actions"></th>
      </tr>
    </thead>
    <tbody>
      <% if @status == :ready %>
        <% @rows.each do |row| %>
          <tr>
            <td><%= feature_discover_status_link(row.id, match: row.match, edition: @edition.edition_id) %></td>
            <td>
              <%= link_to row.name, feature_path(row.id, edition: @edition.edition_id), class: "feature-link" %>
              <div class="feature-id"><code><%= row.id %></code></div>
            </td>
            <td class="num"><%= format_feature_count(row.count) %></td>
            <td class="num"><%= format_feature_count(row.expected) %></td>
            <td><%= row.unit %></td>
            <td><%= row.scope.tr("_", " ") %></td>
            <td class="feature-actions"></td>
          </tr>
        <% end %>
      <% else %>
        <% @catalog.each do |entry| %>
          <% expected = @edition.expected_count(entry.id) %>
          <tr class="row-pending">
            <td><%= feature_discover_pending_link(entry.id, edition: @edition.edition_id) %></td>
            <td>
              <%= link_to entry.name, feature_path(entry.id, edition: @edition.edition_id), class: "feature-link" %>
              <div class="feature-id"><code><%= entry.id %></code></div>
            </td>
            <td class="num muted">—</td>
            <td class="num"><%= format_feature_count(expected) %></td>
            <td><%= entry.unit %></td>
            <td><%= entry.scope.tr("_", " ") %></td>
            <td class="feature-actions"></td>
          </tr>
        <% end %>
      <% end %>
      <% @saved_rows.each do |row| %>
        <tr class="row-saved">
          <td><%= feature_discover_status_link(row.id, match: row.match, edition: @edition.edition_id) %></td>
          <td>
            <%= link_to row.name, feature_path(row.id, edition: @edition.edition_id), class: "feature-link" %>
            <div class="feature-id"><code><%= row.id %></code> <span class="badge badge-muted">saved</span></div>
          </td>
          <td class="num"><%= format_feature_count(row.count) %></td>
          <td class="num"><%= format_feature_count(row.expected) %></td>
          <td><%= row.unit %></td>
          <td><%= row.scope %></td>
          <td class="feature-actions"><%= saved_feature_actions(row, edition: @edition.edition_id) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
