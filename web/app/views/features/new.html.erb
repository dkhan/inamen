<% content_for :title, "Save feature — Inamen" %>
<% content_for :head do %>
  <%= javascript_include_tag "notes_editor", defer: true %>
  <%= javascript_include_tag "feature_save_form", defer: true %>
<% end %>

<div class="page-header">
  <p class="breadcrumb">
    <%= link_to "Discover", discoveries_path(edition: @saved_feature.edition_id) %>
    / Save feature
  </p>
  <h1>Save feature</h1>
  <p class="lead">Save the current Discover word-count scan as a reusable feature.</p>
</div>

<%= form_with model: @saved_feature, url: features_path, method: :post, local: true, class: "feature-save-form" do |form| %>
  <% if @saved_feature.errors.any? %>
    <section class="panel notice">
      <p><strong>Could not save feature.</strong></p>
      <ul>
        <% @saved_feature.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section class="panel">
    <div class="form-field">
      <%= form.label :name, "Name", class: "form-label" %>
      <%= form.text_field :name, required: true, autofocus: true, class: "form-input", placeholder: "My Jesus scan" %>
    </div>

    <%= form.hidden_field :edition_id %>
    <%= form.hidden_field :scope_label %>
    <%= form.hidden_field :mode %>
    <%= form.hidden_field :saved_actual_count, data: { feature_actual_field: true } %>
    <%= form.hidden_field :expected_count, data: { feature_expected_field: true } %>
    <%= form.hidden_field :from_feature if @saved_feature.from_feature.present? %>
    <%= hidden_field_tag "saved_feature[search_selection_json]", @saved_feature.search_selection.to_json %>
    <%= hidden_field_tag "saved_feature[search_phrases_json]", @saved_feature.search_phrases.to_json %>

    <div class="form-field">
      <%= form.label :unit, "Measure", class: "form-label" %>
      <%= form.select :unit,
          options_for_select(@count_options.keys.map { |u| [u.capitalize, u] }, @saved_feature.unit),
          {}, class: "form-input input-narrow", data: { feature_unit_select: true } %>
    </div>

    <dl class="stats" data-feature-counts="<%= @count_options.to_json %>">
      <div>
        <dt>Actual</dt>
        <dd>
          <span data-feature-actual><%= format_feature_count(@saved_feature.saved_actual_count) %></span>
          <span data-feature-unit-label><%= @saved_feature.unit %></span>
        </dd>
      </div>
      <div>
        <dt>Expected</dt>
        <dd>
          <span data-feature-expected><%= format_feature_count(@saved_feature.expected_count) %></span>
          <span data-feature-unit-label><%= @saved_feature.unit %></span>
        </dd>
      </div>
      <div>
        <dt>Status</dt>
        <dd>
          <%= feature_match_badge(@saved_feature.saved_actual_count == @saved_feature.expected_count) %>
        </dd>
      </div>
      <div>
        <dt>Edition</dt>
        <dd><code><%= @saved_feature.edition_id %></code></dd>
      </div>
      <div>
        <dt>Scope</dt>
        <dd><%= @saved_feature.scope_label %></dd>
      </div>
    </dl>

    <div class="form-field">
      <%= form.label :notes, "Notes", class: "form-label" %>
      <%= render "notes_field", form: form %>
    </div>

    <div class="form-field">
      <%= form.label :kjvcode_url, "KJV Code link", class: "form-label" %>
      <%= form.url_field :kjvcode_url, class: "form-input",
          placeholder: "https://kjvcode.com/pattern/..." %>
      <p class="hint">Optional link to a related pattern on kjvcode.com.</p>
    </div>
  </section>

  <% if @saved_feature.details.present? %>
    <section class="panel">
      <h2>Details</h2>
      <ul class="detail-list">
        <% @saved_feature.details.each do |line| %>
          <li><code><%= line %></code></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <div class="form-actions">
    <%= form.submit "Save", class: "button button-primary" %>
    <%= link_to "Cancel", discoveries_path(edition: @saved_feature.edition_id), class: "button button-secondary" %>
  </div>
<% end %>
