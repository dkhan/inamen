<% content_for :title, "Save feature — Inamen" %>

<div class="page-header">
  <p class="breadcrumb">
    <%= link_to "Discover", discoveries_path(edition: @saved_feature.edition_id) %>
    / Save feature
  </p>
  <h1>Save feature</h1>
  <p class="lead">Save the current Discover word-count scan as a reusable feature.</p>
</div>

<%= form_with model: @saved_feature, url: features_path, method: :post, local: true, class: "feature-save-form" do |form| %>
  <% if @saved_feature.errors.any? %>
    <section class="panel notice">
      <p><strong>Could not save feature.</strong></p>
      <ul>
        <% @saved_feature.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section class="panel">
    <div class="form-field">
      <%= form.label :name, "Name", class: "form-label" %>
      <%= form.text_field :name, required: true, autofocus: true, class: "form-input", placeholder: "My Jesus scan" %>
    </div>

    <%= form.hidden_field :edition_id %>
    <%= form.hidden_field :scope_label %>
    <%= form.hidden_field :unit %>
    <%= form.hidden_field :mode %>
    <%= form.hidden_field :saved_actual_count %>
    <%= form.hidden_field :from_feature if @saved_feature.from_feature.present? %>
    <%= hidden_field_tag "saved_feature[search_selection_json]", @saved_feature.search_selection.to_json %>
    <%= hidden_field_tag "saved_feature[search_phrases_json]", @saved_feature.search_phrases.to_json %>

    <dl class="stats">
      <div>
        <dt>Actual</dt>
        <dd><%= format_feature_count(@saved_feature.saved_actual_count) %> <%= @saved_feature.unit %></dd>
      </div>
      <div>
        <dt>Expected</dt>
        <dd>
          <%= form.number_field :expected_count, min: 0, required: true, class: "form-input input-narrow" %>
          <%= @saved_feature.unit %>
        </dd>
      </div>
      <div>
        <dt>Status</dt>
        <dd>
          <%= feature_match_badge(@saved_feature.saved_actual_count == @saved_feature.expected_count) %>
        </dd>
      </div>
      <div>
        <dt>Edition</dt>
        <dd><code><%= @saved_feature.edition_id %></code></dd>
      </div>
      <div>
        <dt>Scope</dt>
        <dd><%= @saved_feature.scope_label %></dd>
      </div>
    </dl>
  </section>

  <% if @saved_feature.details.present? %>
    <section class="panel">
      <h2>Details</h2>
      <ul class="detail-list">
        <% @saved_feature.details.each do |line| %>
          <li><code><%= line %></code></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <div class="form-actions">
    <%= form.submit "Save", class: "button button-primary" %>
    <%= link_to "Cancel", discoveries_path(edition: @saved_feature.edition_id), class: "button button-secondary" %>
  </div>
<% end %>
