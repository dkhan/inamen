<% content_for :title, "Edit feature — Inamen" %>
<% content_for :head do %>
  <%= javascript_include_tag "notes_editor", defer: true %>
<% end %>

<div class="page-header">
  <p class="breadcrumb">
    <%= link_to "Features", features_path(edition: @edition.edition_id) %>
    / <%= link_to @saved_feature.name, feature_path(@saved_feature.url_id, edition: @edition.edition_id) %>
    / Edit
  </p>
  <h1>Edit feature</h1>
  <p class="lead">Update the name, description, expected count, notes, or KJV Code link for this saved feature.</p>
</div>

<%= form_with url: feature_path(@saved_feature.url_id, edition: @edition.edition_id),
    method: :patch, scope: :saved_feature, local: true, class: "feature-save-form" do |form| %>
  <% if @saved_feature.errors.any? %>
    <section class="panel notice">
      <p><strong>Could not update feature.</strong></p>
      <ul>
        <% @saved_feature.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section class="panel">
    <div class="form-field">
      <%= form.label :name, "Name", class: "form-label" %>
      <%= form.text_field :name, required: true, autofocus: true, class: "form-input" %>
    </div>

    <div class="form-field">
      <%= form.label :description, "Description", class: "form-label" %>
      <%= form.text_field :description, class: "form-input",
          placeholder: SavedFeature::DEFAULT_DESCRIPTION %>
    </div>

    <div class="form-field">
      <%= form.label :feature_type, "Feature type", class: "form-label" %>
      <%= form.select :feature_type, feature_type_options(@saved_feature.feature_type),
          {}, required: true, class: "form-input input-narrow" %>
    </div>

    <div class="form-field">
      <%= form.label :language, "Language", class: "form-label" %>
      <%= form.select :language, feature_language_options(@saved_feature.language),
          {}, required: true, class: "form-input input-narrow" %>
    </div>

    <dl class="stats">
      <div>
        <dt>Expected</dt>
        <dd>
          <%= form.number_field :expected_count, min: 0, required: true, class: "form-input input-narrow" %>
          <%= @saved_feature.unit %>
        </dd>
      </div>
      <div>
        <dt>Unit</dt>
        <dd><%= @saved_feature.unit %></dd>
      </div>
      <div>
        <dt>Scope</dt>
        <dd><%= @saved_feature.display_scope_label %></dd>
      </div>
      <div>
        <dt>Language</dt>
        <dd><%= feature_language_label(@saved_feature.language) %></dd>
      </div>
    </dl>

    <div class="form-field">
      <%= form.label :notes, "Notes", class: "form-label" %>
      <%= render "notes_field", form: form %>
    </div>

    <div class="form-field">
      <%= form.label :kjvcode_url, "KJV Code link", class: "form-label" %>
      <%= form.url_field :kjvcode_url, class: "form-input",
          placeholder: "https://kjvcode.com/pattern/..." %>
      <p class="hint">Optional link to a related pattern on kjvcode.com.</p>
    </div>
  </section>

  <% if @edition_results.present? %>
    <%= render "edition_results", results: @edition_results, saved_feature: @saved_feature %>
  <% end %>

  <% if @saved_feature.details.present? %>
    <section class="panel">
      <h2>Details</h2>
      <ul class="detail-list">
        <li><code>Scope: <%= @saved_feature.display_scope_label %></code></li>
        <% @saved_feature.details.each do |line| %>
          <li><code><%= line %></code></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <div class="form-actions">
    <%= form.submit "Save", class: "button button-primary" %>
    <%= link_to "Cancel", features_path(edition: @edition.edition_id), class: "button button-secondary" %>
  </div>
<% end %>
