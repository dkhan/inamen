<% phrases = discovery_search_phrase_rows(scan_params) %>

<div class="search-phrases-field" id="search-phrases-panel"
    data-dictionary-url="<%= dictionary_discoveries_path(edition: @edition.edition_id, v: @edition.checksum_prefix, format: :json) %>"
    <%= "data-focus-on-load=\"true\"" if @discover_query_fresh %>>
  <span class="search-phrases-label">Search phrases</span>
  <div id="search-phrases-list" data-search-phrases-list>
    <% phrases.each do |index, phrase| %>
      <%= render "search_phrase_row", index: index, phrase: phrase %>
    <% end %>
  </div>
  <div class="search-phrases-actions">
    <button type="button" class="button button-primary" id="add-search-phrase">Add Search Phrase</button>
  </div>
</div>

<template id="search-phrase-row-template">
  <%= render "search_phrase_row",
      index: "__INDEX__",
      phrase: DiscoveryScan::PhraseEntry.new(phrase: "", case_sensitive: false, exclude: false, disabled: false) %>
</template>
