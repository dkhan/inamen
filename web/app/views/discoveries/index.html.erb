<% content_for :title, "Discover — Inamen" %>
<% if @status == :computing %>
  <% content_for :head do %>
    <meta http-equiv="refresh" content="3">
  <% end %>
<% end %>

<% equal_count_mode = @scan_params.mode == "equal_count" %>

<div class="page-header">
  <p class="eyebrow">Pattern discovery</p>
  <h1><%= equal_count_mode ? "Equal count groups" : "Divisibility scan" %></h1>
  <% if @status == :ready %>
    <% if equal_count_mode %>
      <p class="lead">
        <strong><%= @rows.size %></strong> groups on
        <code><%= @edition.edition_id %></code>
        where <%= @scan_params.min_group_size %>+ <%= @scan_params.match_by == "spelling" ? "spellings" : "words" %> share the same count
        (<%= @scan_params.scope.tr("_", " ") %>, min count <%= @scan_params.min_count %>).
      </p>
    <% else %>
      <p class="lead">
        <strong><%= @rows.size %></strong> tokens on
        <code><%= @edition.edition_id %></code>
        whose counts are divisible by <%= @scan_params.divisible_by %>
        (<%= @scan_params.scope.tr("_", " ") %>, min <%= @scan_params.min_count %>).
      </p>
    <% end %>
  <% else %>
    <p class="lead">
      Hunt for numeric patterns in token counts —
      edition <code><%= @edition.edition_id %></code>.
    </p>
  <% end %>
</div>

<section class="panel toolbar">
  <%= form_with url: discoveries_path, method: :get, local: true, class: "toolbar-form discovery-filters" do %>
    <label>
      Scan type
      <%= select_tag :mode, discovery_mode_options(@scan_params.mode), onchange: "this.form.requestSubmit()" %>
    </label>
    <label>
      Edition
      <%= select_tag :edition, edition_options(@edition.edition_id) %>
    </label>
    <% unless equal_count_mode %>
      <label>
        Divisible by
        <%= number_field_tag :divisible_by, @scan_params.divisible_by, min: 1, max: 10_000, class: "input-narrow" %>
      </label>
    <% end %>
    <label>
      Scope
      <%= select_tag :scope, discovery_scope_options(@scan_params.scope) %>
    </label>
    <label>
      Bucket
      <%= select_tag :bucket, discovery_bucket_options(@scan_params.bucket) %>
    </label>
    <label>
      Min count
      <%= number_field_tag :min_count, @scan_params.min_count, min: 1, class: "input-narrow" %>
    </label>
    <% if equal_count_mode %>
      <label>
        Match by
        <%= select_tag :match_by, discovery_match_by_options(@scan_params.match_by) %>
      </label>
      <label>
        Min words per group
        <%= number_field_tag :min_group_size, @scan_params.min_group_size, min: 2, class: "input-narrow" %>
      </label>
    <% end %>
    <%= button_tag "Apply filters", type: "submit", class: "button button-secondary" %>
  <% end %>

  <%= form_with url: scan_discoveries_path, method: :post, local: true, class: "toolbar-form toolbar-actions" do %>
    <% discovery_scan_query(@edition, @scan_params).each do |key, value| %>
      <%= hidden_field_tag key, value %>
    <% end %>
    <% unless @status == :ready %>
      <%= button_tag "Run scan", type: "submit", class: "button button-primary" %>
    <% end %>
    <%= button_tag "Rescan", name: "refresh", value: "1", type: "submit", class: "button button-secondary" %>
  <% end %>

  <p class="hint">
    First scan builds the corpus index if needed (about a minute), then queries are fast.
    <% if equal_count_mode %>
      <strong>Normalized word</strong> sums all spellings (e.g. seven + Seven = 463).
      <strong>Spelling</strong> matches the divisibility list row-by-row (e.g. seven = 448).
    <% end %>
  </p>
</section>

<% if @status == :computing %>
  <section class="panel notice">
    <p><strong>Scanning…</strong> Building the index and querying token counts. This page refreshes every few seconds.</p>
  </section>
<% elsif @status == :pending %>
  <section class="panel notice">
    <p><strong>No results yet.</strong> Set filters above, then click <em>Run scan</em>.</p>
  </section>
<% end %>

<% if @status == :ready %>
  <section class="panel">
    <% if equal_count_mode %>
      <table class="features-table discovery-table">
        <thead>
          <tr>
            <th class="num">Count</th>
            <th class="num">Words</th>
            <th>Shared by</th>
          </tr>
        </thead>
        <tbody>
          <% @rows.each do |row| %>
            <tr>
              <td class="num"><%= format_feature_count(row.count) %></td>
              <td class="num"><%= row.words.size %></td>
              <td class="word-group"><%= discovery_equal_count_words_label(row.words, match_by: row.match_by) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <table class="features-table discovery-table">
        <thead>
          <tr>
            <th>Token (normalized)</th>
            <th>Token (raw)</th>
            <th class="num">Count</th>
            <th class="num">÷ <%= @scan_params.divisible_by %></th>
          </tr>
        </thead>
        <tbody>
          <% @rows.each do |row| %>
            <tr>
              <td><code><%= row.token_norm %></code></td>
              <td><code><%= row.token_raw %></code></td>
              <td class="num"><%= format_feature_count(row.count) %></td>
              <td class="num"><%= row.count / @scan_params.divisible_by %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </section>
<% end %>
