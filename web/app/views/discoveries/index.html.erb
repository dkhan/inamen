<% content_for :title, "Discover — Inamen" %>
<% if @status == :computing %>
  <% content_for :head do %>
    <meta http-equiv="refresh" content="3">
  <% end %>
<% end %>
<% content_for :head do %>
  <%= javascript_include_tag "search_within_tree", defer: true %>
<% end %>

<% word_count_mode = @scan_params.mode == "word_count" %>
<% equal_count_mode = @scan_params.mode == "equal_count" %>
<% filter_scan_mode = !word_count_mode %>
<% selection = @scan_params.search_selection %>
<% selection_label = discovery_selection_label(selection) %>

<div class="page-header">
  <p class="eyebrow">Pattern discovery</p>
  <h1>
    <% if word_count_mode %>
      Word count
    <% elsif equal_count_mode %>
      Equal count groups
    <% else %>
      Divisibility scan
    <% end %>
  </h1>
  <% if @status == :ready %>
    <% if word_count_mode %>
      <p class="lead">
        <strong><%= @rows.size %></strong> search terms on
        <code><%= @edition.edition_id %></code>
        (<%= selection_label %>).
      </p>
    <% elsif equal_count_mode %>
      <p class="lead">
        <strong><%= @rows.size %></strong> groups on
        <code><%= @edition.edition_id %></code>
        where <%= @scan_params.min_group_size %>+ <%= @scan_params.match_by == "spelling" ? "spellings" : "words" %> share the same count
        (<%= selection_label %>, min count <%= @scan_params.min_count %>).
      </p>
    <% else %>
      <p class="lead">
        <strong><%= @rows.size %></strong> tokens on
        <code><%= @edition.edition_id %></code>
        whose counts are divisible by <%= @scan_params.divisible_by %>
        (<%= selection_label %>, min <%= @scan_params.min_count %>).
      </p>
    <% end %>
  <% else %>
    <p class="lead">
      Hunt for numeric patterns in token counts —
      edition <code><%= @edition.edition_id %></code>.
    </p>
  <% end %>
</div>

<section class="panel toolbar">
  <%= form_with url: discoveries_path, method: :get, local: true, class: "toolbar-form" do %>
    <%= discovery_scan_hidden_fields(@scan_params) %>
    <label>
      Edition
      <%= select_tag :edition, edition_options(@edition.edition_id), onchange: "this.form.requestSubmit()" %>
    </label>
  <% end %>

  <p class="hint">
    Switch edition to view cached scans for that corpus. Your scan settings are preserved.
  </p>
</section>

<section class="panel toolbar discovery-toolbar">
  <%= form_with url: discoveries_path, method: :get, local: true, id: "discovery-filters-form", class: "discovery-layout" do %>
    <%= hidden_field_tag :edition, @edition.edition_id %>
    <%= hidden_field_tag :authenticity_token, form_authenticity_token, id: nil %>

    <aside class="discovery-search-within">
      <%= render "search_within_tree", selection: selection %>
    </aside>

    <div class="discovery-main">
      <div class="toolbar-form discovery-filters">
        <label>
          Scan type
          <%= select_tag :mode, discovery_mode_options(@scan_params.mode), onchange: "this.form.requestSubmit()" %>
        </label>
        <% if word_count_mode %>
          <label class="query-terms-field">
            Search terms
            <%= text_area_tag :query_terms, @scan_params.query_terms, rows: 6, class: "query-terms-input",
                placeholder: "*jesus*\nsix|cs\nseven" %>
          </label>
        <% end %>
        <% unless equal_count_mode || word_count_mode %>
          <label>
            Divisible by
            <%= number_field_tag :divisible_by, @scan_params.divisible_by, min: 1, max: 10_000, class: "input-narrow" %>
          </label>
        <% end %>
        <% if filter_scan_mode %>
          <label>
            Min count
            <%= number_field_tag :min_count, @scan_params.min_count, min: 1, class: "input-narrow" %>
          </label>
        <% end %>
        <% if equal_count_mode %>
          <label>
            Match by
            <%= select_tag :match_by, discovery_match_by_options(@scan_params.match_by) %>
          </label>
          <label>
            Min words per group
            <%= number_field_tag :min_group_size, @scan_params.min_group_size, min: 2, class: "input-narrow" %>
          </label>
        <% end %>
      </div>

      <div class="toolbar-form toolbar-actions">
        <% unless @status == :ready %>
          <%= button_tag "Run scan", type: "submit", class: "button button-primary",
              form: "discovery-filters-form", formaction: scan_discoveries_path, formmethod: "post" %>
        <% end %>
        <%= button_tag "Rescan", name: "refresh", value: "1", type: "submit", class: "button button-secondary",
            form: "discovery-filters-form", formaction: scan_discoveries_path, formmethod: "post" %>
      </div>

      <p class="hint">
        First scan builds the corpus index if needed (about a minute), then queries are fast.
        <% if word_count_mode %>
          One term per line. Append <code>|cs</code> for case-sensitive whole-token match.
          Use <code>*</code> before or after text to match within a token (e.g. <code>*jesus*</code> matches <code>Bar-jesus</code>).
        <% elsif equal_count_mode %>
          <strong>Normalized word</strong> sums all spellings (e.g. seven + Seven = 463).
          <strong>Spelling</strong> matches the divisibility list row-by-row (e.g. seven = 448).
        <% end %>
      </p>
    </div>
  <% end %>
</section>

<% if @status == :computing %>
  <section class="panel notice">
    <p><strong>Scanning…</strong> Building the index and querying token counts. This page refreshes every few seconds.</p>
  </section>
<% elsif @status == :pending %>
  <section class="panel notice">
    <p><strong>No results yet.</strong>
      <% if word_count_mode %>
        Enter search terms above, then click <em>Run scan</em>.
      <% else %>
        Click <em>Run scan</em> to query with the current settings.
      <% end %>
    </p>
  </section>
<% end %>

<% if @status == :ready %>
  <section class="panel">
    <% if word_count_mode %>
      <table class="features-table discovery-table">
        <thead>
          <tr>
            <th>Pattern</th>
            <th>Case</th>
            <th class="num">Count</th>
            <th>Spellings</th>
          </tr>
        </thead>
        <tbody>
          <% @rows.each do |row| %>
            <tr>
              <td><code><%= row.pattern %></code><% if row.wildcard %> <span class="badge badge-muted">wildcard</span><% end %></td>
              <td><%= row.case_sensitive ? "sensitive" : "insensitive" %></td>
              <td class="num"><%= format_feature_count(row.count) %></td>
              <td class="word-group"><%= discovery_word_count_spellings_label(row.spellings) %></td>
            </tr>
          <% end %>
        </tbody>
        <% if @rows.size > 1 %>
          <tfoot>
            <tr class="row-total">
              <td colspan="2"><strong>Total</strong></td>
              <td class="num"><strong><%= format_feature_count(discovery_word_count_total(@rows)) %></strong></td>
              <td></td>
            </tr>
          </tfoot>
        <% end %>
      </table>
    <% elsif equal_count_mode %>
      <table class="features-table discovery-table">
        <thead>
          <tr>
            <th class="num">Count</th>
            <th class="num">Words</th>
            <th>Shared by</th>
          </tr>
        </thead>
        <tbody>
          <% @rows.each do |row| %>
            <tr>
              <td class="num"><%= format_feature_count(row.count) %></td>
              <td class="num"><%= row.words.size %></td>
              <td class="word-group"><%= discovery_equal_count_words_label(row.words, match_by: row.match_by) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <table class="features-table discovery-table">
        <thead>
          <tr>
            <th>Token (normalized)</th>
            <th>Token (raw)</th>
            <th class="num">Count</th>
            <th class="num">÷ <%= @scan_params.divisible_by %></th>
          </tr>
        </thead>
        <tbody>
          <% @rows.each do |row| %>
            <tr>
              <td><code><%= row.token_norm %></code></td>
              <td><code><%= row.token_raw %></code></td>
              <td class="num"><%= format_feature_count(row.count) %></td>
              <td class="num"><%= row.count / @scan_params.divisible_by %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </section>
<% end %>
