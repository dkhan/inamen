<% content_for :title, "Discover — Inamen" %>
<% content_for :main_class, "site-main site-main-wide" %>
<% word_count_mode = @scan_params.mode == "word_count" %>
<% file_stats_mode = @scan_params.mode == "file_stats" %>
<% equal_count_mode = @scan_params.mode == "equal_count" %>
<% filter_scan_mode = !word_count_mode && !file_stats_mode %>
<% selection = @scan_params.search_selection %>
<% if @status == :computing %>
  <% content_for :head do %>
    <meta http-equiv="refresh" content="3">
    <meta name="turbo-cache-control" content="no-cache">
  <% end %>
<% end %>
<% content_for :head do %>
  <%= javascript_include_tag "search_within_tree", defer: true %>
  <%= javascript_include_tag "search_phrases", defer: true %>
  <%= javascript_include_tag "discovery_scan_form", defer: true %>
  <%= javascript_include_tag "discovery_phrase_complete", defer: true if word_count_mode %>
  <%= javascript_include_tag "discovery_verse_loader", defer: true if word_count_mode && @verse_result.nil? %>
  <%= javascript_include_tag "discovery_verse_details", defer: true if word_count_mode %>
  <%= javascript_include_tag "discovery_verse_show_more", defer: true if word_count_mode %>
<% end %>

<section class="panel toolbar">
  <%= form_with url: discoveries_path, method: :get, local: true, class: "toolbar-form" do %>
    <%= discovery_scan_hidden_fields(@scan_params) %>
    <label>
      Edition
      <%= select_tag :edition, edition_options(@edition.edition_id), onchange: "this.form.requestSubmit()" %>
    </label>
  <% end %>

  <p class="hint">
    Switch edition to view cached scans for that corpus. Your scan settings are preserved.
  </p>
</section>

<section class="panel toolbar discovery-toolbar">
  <%= form_with url: discoveries_path, method: :get, local: true, id: "discovery-filters-form",
      class: "discovery-layout",
      data: {
        scan_action: scan_discoveries_path,
        status: @status,
        results_ready: (@status == :ready ? "true" : nil)
      }.compact do %>
    <%= hidden_field_tag :edition, @edition.edition_id %>
    <%= hidden_field_tag :authenticity_token, form_authenticity_token, id: nil %>

    <aside class="discovery-search-within<%= " is-hidden" if file_stats_mode %>">
      <%= render "search_within_tree", selection: selection %>
    </aside>

    <div class="discovery-main">
      <div class="toolbar-form discovery-filters">
        <label>
          Scan type
          <%= select_tag :mode, discovery_mode_options(@scan_params.mode), onchange: "this.form.requestSubmit()" %>
        </label>
        <% if word_count_mode %>
          <div class="discovery-phrase-toolbar-actions" aria-label="Search phrase tools">
            <% if @status == :ready %>
              <%= link_to "Save feature",
                  feature_save_path(actual_count: discovery_word_count_total(@rows), edition: @edition.edition_id),
                  class: "discovery-phrase-action" %>
            <% end %>
            <button type="button" class="discovery-phrase-action" id="clear-search-phrases">Clear all</button>
          </div>
        <% end %>
        <% if word_count_mode %>
          <%= render "search_phrases", scan_params: @scan_params %>
        <% end %>
        <% unless equal_count_mode || word_count_mode || file_stats_mode %>
          <label>
            Divisible by
            <%= number_field_tag :divisible_by, @scan_params.divisible_by, min: 1, max: 10_000, class: "input-narrow" %>
          </label>
        <% end %>
        <% if filter_scan_mode %>
          <label>
            Min count
            <%= number_field_tag :min_count, @scan_params.min_count, min: 1, class: "input-narrow" %>
          </label>
        <% end %>
        <% if equal_count_mode %>
          <label>
            Match by
            <%= select_tag :match_by, discovery_match_by_options(@scan_params.match_by) %>
          </label>
          <label>
            Min words per group
            <%= number_field_tag :min_group_size, @scan_params.min_group_size, min: 2, class: "input-narrow" %>
          </label>
        <% end %>
      </div>
    </div>
  <% end %>
</section>

<% if @status == :computing %>
  <section class="panel notice">
    <p><strong>Scanning…</strong> Building the index and querying token counts. This page refreshes every few seconds.</p>
  </section>
<% elsif @status == :pending %>
  <section class="panel notice">
    <p><strong>No results yet.</strong>
      <% if word_count_mode %>
        Enter a search phrase and press <em>Enter</em>, or toggle a checkbox, to scan.
        Separate multiple terms in one box with <code>|</code> (e.g. <code>six|seven</code>).
      <% elsif file_stats_mode %>
        Select <em>File stats</em> to view the whole-file word breakdown for the 7<sup>7</sup> feature.
      <% else %>
        Press <em>Enter</em> in a filter field to run a scan with the current settings.
      <% end %>
    </p>
  </section>
<% end %>

<% if @status == :ready %>
  <section class="panel" data-discovery-results>
    <% if word_count_mode %>
      <p class="discovery-verse-summary"><%= discovery_word_match_summary(@rows, @scan_params, summary: @word_summary) %></p>
      <table class="features-table discovery-table">
        <thead>
          <tr>
            <th>Pattern</th>
            <th>Case</th>
            <th class="num">Count</th>
            <th>Spellings</th>
          </tr>
        </thead>
        <tbody>
          <% @rows.each do |row| %>
            <tr>
              <td><code><%= row.pattern %></code>
                <% if row.wildcard %> <span class="badge badge-muted">wildcard</span><% end %>
                <% if row.exclude %> <span class="badge badge-muted">exclude</span><% end %>
              </td>
              <td><%= row.case_sensitive ? "sensitive" : "insensitive" %></td>
              <td class="num"><%= row.exclude ? "−" : "" %><%= number_research_link(row.count) %></td>
              <td class="word-group"><%= discovery_word_count_spellings_label(row.spellings) %></td>
            </tr>
          <% end %>
        </tbody>
        <% if @rows.size > 1 %>
          <tfoot>
            <tr class="row-total">
              <td colspan="2"><strong>Total</strong></td>
              <td class="num"><strong><%= number_research_link(discovery_word_count_total(@rows)) %></strong></td>
              <td></td>
            </tr>
          </tfoot>
        <% end %>
      </table>
      <% if word_count_mode %>
        <% if @verse_result %>
          <%= render "verse_results", edition: @edition, verse_result: @verse_result %>
        <% else %>
          <div id="discovery-verse-results" data-verses-url="<%= verses_discoveries_path(discovery_verses_query(@edition, @scan_params)) %>">
            <%= render "verse_loading" %>
          </div>
        <% end %>
        <%= render "verse_details_dialog" %>
      <% end %>
    <% elsif file_stats_mode && @file_stats %>
      <%= render "file_stats_explorer", file_stats: @file_stats %>
      <table class="features-table discovery-table discovery-file-stats legacy-file-stats">
        <thead>
          <tr>
            <th>Legacy whole-file feature</th>
            <th class="num">Count</th>
          </tr>
        </thead>
        <tbody>
          <% @file_stats.rows.each do |row| %>
            <tr>
              <td><%= row.label %></td>
              <td class="num"><%= number_research_link(row.count) %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr class="row-total <%= discovery_file_stats_row_class("combined_total") %>">
            <td><strong>Total words and numbers</strong></td>
            <td class="num"><strong><%= number_research_link(@file_stats.total) %></strong></td>
          </tr>
          <tr class="<%= discovery_file_stats_row_class("file_characters") %>">
            <td>Total file characters</td>
            <td class="num"><%= number_research_link(@file_stats.character_count) %></td>
          </tr>
        </tfoot>
      </table>
    <% elsif equal_count_mode %>
      <table class="features-table discovery-table">
        <thead>
          <tr>
            <th class="num">Count</th>
            <th class="num">Words</th>
            <th>Shared by</th>
          </tr>
        </thead>
        <tbody>
          <% @rows.each do |row| %>
            <tr>
              <td class="num"><%= number_research_link(row.count) %></td>
              <td class="num"><%= row.words.size %></td>
              <td class="word-group"><%= discovery_equal_count_words_label(row.words, match_by: row.match_by) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <table class="features-table discovery-table">
        <thead>
          <tr>
            <th>Token (normalized)</th>
            <th>Token (raw)</th>
            <th class="num">Count</th>
            <th class="num">÷ <%= @scan_params.divisible_by %></th>
          </tr>
        </thead>
        <tbody>
          <% @rows.each do |row| %>
            <tr>
              <td><code><%= row.token_norm %></code></td>
              <td><code><%= row.token_raw %></code></td>
              <td class="num"><%= number_research_link(row.count) %></td>
              <td class="num"><%= number_research_link(row.count / @scan_params.divisible_by) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </section>
<% end %>
