<% return if verse_result.blank? %>

<section class="panel discovery-verse-results" data-verses-ready>
  <% if verse_result.verses.blank? %>
    <p class="hint">No verse matches.</p>
  <% else %>
  <ol class="discovery-verse-list">
    <%= render "verse_result_rows",
        edition: edition,
        verse_result: verse_result,
        offset: 0,
        limit: discovery_verse_results_display_limit %>
  </ol>

  <% remaining = discovery_verse_results_remaining_count(verse_result) %>
  <% if remaining.positive? %>
    <div class="discovery-verse-more">
      <button type="button"
          class="button button-secondary discovery-verse-show-more"
          data-more-url="<%= discovery_verses_more_url(edition, @scan_params, offset: discovery_verse_results_display_limit) %>"
          data-offset="<%= discovery_verse_results_display_limit %>"
          data-remaining="<%= remaining %>">
        <%= discovery_verse_show_more_label(remaining) %>
      </button>
    </div>
  <% end %>
  <% end %>
</section>
