<% return if verse_result.blank? %>

<section class="panel discovery-verse-results" data-verses-ready>
  <% if verse_result.verses.blank? %>
    <p class="hint">No verse matches.</p>
  <% else %>
  <p class="discovery-verse-summary"><%= discovery_verse_match_summary(verse_result.summary) %></p>
  <% if discovery_verse_results_truncated?(verse_result) %>
    <p class="hint">Showing first <%= discovery_verse_results_display_limit %> of <%= number_with_delimiter(verse_result.verses.length) %> verses.</p>
  <% end %>

  <ol class="discovery-verse-list">
    <% discovery_verse_results_rows(verse_result).each do |row| %>
      <li class="discovery-verse-item">
        <%= link_to discovery_verse_reference(row),
            discovery_scripture_chapter_path(edition, row),
            class: "discovery-verse-ref" %>
        <span class="discovery-verse-text"><%= discovery_verse_row_html(row) %></span>
        <button type="button"
            class="discovery-verse-details-button"
            aria-label="Match details"
            title="Match details"
            data-verse-details="<%= h(discovery_verse_row_details(row).to_json) %>">☰</button>
      </li>
    <% end %>
  </ol>
  <% end %>
</section>
