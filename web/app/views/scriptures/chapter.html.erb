<% content_for :title, "#{@title} — Scripture — Inamen" %>
<% content_for :head do %>
  <%= javascript_include_tag "scripture_navigation", defer: true %>
<% end %>

<section class="panel scripture-panel">
  <div class="scripture-picker">
    <label>
      Edition
      <%= select_tag :scripture_edition,
          edition_options(@edition.edition_id),
          id: "scripture-edition-select" %>
    </label>

    <label>
      Book
      <%= select_tag :scripture_book,
          options_for_select(@scripture_books, @book),
          id: "scripture-book-select",
          data: {
            chapters: @scripture_books.to_h { |book| [book, @edition.chapter_numbers(book)] }.to_json,
            path_template: scripture_chapter_path(book: "__BOOK__", chapter: "__CHAPTER__", edition: "__EDITION__")
          } %>
    </label>

    <label>
      Chapter
      <%= select_tag :scripture_chapter,
          options_for_select(@scripture_chapters, @chapter),
          id: "scripture-chapter-select" %>
    </label>
  </div>

  <nav class="scripture-chapter-nav" aria-label="Chapter navigation">
  <% if @prev_chapter %>
    <%= link_to "← Prev", scripture_chapter_link(@prev_chapter, edition_id: @edition.edition_id), class: "scripture-nav-button" %>
  <% else %>
    <span class="scripture-nav-button is-disabled" aria-hidden="true">← Prev</span>
  <% end %>

  <h1 class="scripture-title"><%= @title %></h1>

  <% if @next_chapter %>
    <%= link_to "Next →", scripture_chapter_link(@next_chapter, edition_id: @edition.edition_id), class: "scripture-nav-button" %>
  <% else %>
    <span class="scripture-nav-button is-disabled" aria-hidden="true">Next →</span>
  <% end %>
  </nav>

  <div class="scripture-chapter">
    <% if @superscription_text.present? %>
      <% highlight_superscription = @highlight_extra_bucket && @bucket == Inamen::CorpusStore::BUCKET_PSALM_HEADING %>
      <p id="superscription" class="scripture-extra scripture-superscription<%= " is-highlighted" if highlight_superscription %>">
        <span class="scripture-extra-label">Sup.</span>
        <%= scripture_bucket_html(
              @edition,
              book: @book,
              chapter: @chapter,
              bucket: Inamen::CorpusStore::BUCKET_PSALM_HEADING,
              highlight_indices: highlight_superscription ? @highlight_indices : []
            ) %>
      </p>
    <% end %>

    <% @verses.sort.each do |verse_number, text| %>
      <p id="v<%= verse_number %>" class="scripture-verse<%= " is-highlighted" if @highlight_verse == verse_number && !@highlight_extra_bucket %>">
        <span class="verse-num"><%= verse_number %></span>
        <% if @highlight_verse == verse_number && @highlight_indices.any? && !@highlight_extra_bucket %>
          <% if @bucket == Inamen::CorpusStore::BUCKET_VERSE_TEXT %>
            <%= Inamen::VerseHighlighter.highlight_text(text, @highlight_indices) %>
          <% else %>
            <%= Inamen::VerseHighlighter.render_row(
                  @edition.lines,
                  @edition.db,
                  Inamen::VerseMatchQuery::VerseRow.new(
                    book: @book,
                    chapter: @chapter,
                    verse: verse_number,
                    bucket: @bucket,
                    occurrence_count: 0,
                    highlight_indices: @highlight_indices,
                    first_hit_index: nil
                  )
                ) %>
          <% end %>
        <% else %>
          <%= h(text) %>
        <% end %>
      </p>
    <% end %>

    <% if @colophon_text.present? %>
      <% highlight_colophon = @highlight_extra_bucket && @bucket == Inamen::CorpusStore::BUCKET_COLOPHON %>
      <p id="colophon" class="scripture-extra scripture-colophon<%= " is-highlighted" if highlight_colophon %>">
        <span class="scripture-extra-label">Col.</span>
        <%= scripture_bucket_html(
              @edition,
              book: @book,
              chapter: @chapter,
              bucket: Inamen::CorpusStore::BUCKET_COLOPHON,
              highlight_indices: highlight_colophon ? @highlight_indices : []
            ) %>
      </p>
    <% end %>
  </div>

  <nav class="scripture-chapter-nav scripture-chapter-nav-footer" aria-label="Chapter navigation">
  <% if @prev_chapter %>
    <%= link_to "← Prev", scripture_chapter_link(@prev_chapter, edition_id: @edition.edition_id), class: "scripture-nav-button" %>
  <% else %>
    <span class="scripture-nav-button is-disabled" aria-hidden="true">← Prev</span>
  <% end %>

  <% if @next_chapter %>
    <%= link_to "Next →", scripture_chapter_link(@next_chapter, edition_id: @edition.edition_id), class: "scripture-nav-button" %>
  <% else %>
    <span class="scripture-nav-button is-disabled" aria-hidden="true">Next →</span>
  <% end %>
  </nav>
</section>

<% if @highlight_scroll_target %>
  <% content_for :head do %>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const target = document.getElementById("<%= @highlight_scroll_target %>");
        if (target) target.scrollIntoView({ block: "center" });
      });
    </script>
  <% end %>
<% end %>
