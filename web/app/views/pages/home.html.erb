<div class="hero">
  <p class="eyebrow">Text pattern research lab</p>
  <h1>Inamen</h1>
  <p class="lead">
    Discover and verify mathematical patterns in plain text.
    Editions are imported locally and indexed for fast discovery.
  </p>
</div>

<section class="panel">
  <h2>Engine</h2>
  <dl class="stats">
    <div>
      <dt>Version</dt>
      <dd><code><%= @engine_version %></code></dd>
    </div>
    <div>
      <dt>Saved features</dt>
      <dd><%= @feature_count %></dd>
    </div>
    <div>
      <dt>Indexer revision</dt>
      <dd><code><%= Rails.application.config.inamen.indexer_revision %></code></dd>
    </div>
  </dl>
</section>

<section class="panel">
  <h2>Editions</h2>
  <table>
    <thead>
      <tr>
        <th>Edition</th>
        <th>Name</th>
        <th>File</th>
        <th>Size</th>
        <th>SHA-256 (prefix)</th>
      </tr>
    </thead>
    <tbody>
      <% @editions.each do |edition| %>
        <tr>
          <td><code><%= edition[:id] %></code></td>
          <td><%= edition[:name] %></td>
          <td><%= edition[:filename] %></td>
          <td><%= number_to_human_size(edition[:bytes]) %></td>
          <td><code><%= edition[:sha256] %></code></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>

<section class="panel">
  <h2>Explore</h2>
  <p>
    Browse <%= link_to "saved features", features_path, class: "inline-link" %>
    — <%= @feature_count %> reusable patterns with definitions and live counts.
    Or <%= link_to "run a discovery scan", discoveries_path, class: "inline-link" %>
    to find tokens with counts divisible by any integer.
  </p>
</section>

<section class="panel muted">
  <h2>Coming next</h2>
  <p>Per-chapter heatmaps, edition comparison, and saved result workflows.</p>
</section>
